{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "CMS config",
	"$defs": {
		"Field": {
			"type": "object",
			"required": [
				"name",
				"type"
			],
			"properties": {
				"name": {
					"type": "string",
					"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
				},
				"type": {
					"anyOf": [
						{
							"type": "string",
							"const": "text"
						},
						{
							"type": "string",
							"const": "textarea"
						},
						{
							"type": "string",
							"const": "richtext"
						},
						{
							"type": "string",
							"const": "markdown"
						},
						{
							"type": "string",
							"const": "code"
						},
						{
							"type": "string",
							"const": "number"
						},
						{
							"type": "string",
							"const": "boolean"
						},
						{
							"type": "string",
							"const": "select"
						},
						{
							"type": "string",
							"const": "multiselect"
						},
						{
							"type": "string",
							"const": "date"
						},
						{
							"type": "string",
							"const": "datetime"
						},
						{
							"type": "string",
							"const": "time"
						},
						{
							"type": "string",
							"const": "color"
						},
						{
							"type": "string",
							"const": "email"
						},
						{
							"type": "string",
							"const": "url"
						},
						{
							"type": "string",
							"const": "link"
						},
						{
							"type": "string",
							"const": "image"
						},
						{
							"type": "string",
							"const": "file"
						},
						{
							"type": "string",
							"const": "gallery"
						},
						{
							"type": "string",
							"const": "relation"
						},
						{
							"type": "string",
							"const": "page"
						},
						{
							"type": "string",
							"const": "tags"
						},
						{
							"type": "string",
							"const": "repeater"
						},
						{
							"type": "string",
							"const": "group"
						},
						{
							"type": "string",
							"const": "blocks"
						}
					]
				},
				"label": {
					"type": "string"
				},
				"help": {
					"type": "string"
				},
				"placeholder": {
					"type": "string"
				},
				"required": {
					"type": "boolean"
				},
				"default": {},
				"width": {
					"anyOf": [
						{
							"type": "string",
							"const": "full"
						},
						{
							"type": "string",
							"const": "half"
						},
						{
							"type": "string",
							"const": "third"
						}
					]
				},
				"min": {
					"type": "number"
				},
				"max": {
					"type": "number"
				},
				"step": {
					"type": "number"
				},
				"rows": {
					"type": "integer",
					"minimum": 1
				},
				"options": {
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "object",
								"required": [
									"value",
									"label"
								],
								"properties": {
									"value": {
										"type": "string"
									},
									"label": {
										"type": "string"
									}
								}
							}
						]
					}
				},
				"fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Field"
					}
				},
				"itemLabel": {
					"type": "string"
				},
				"collection": {
					"type": "string"
				},
				"multiple": {
					"type": "boolean"
				},
				"accept": {
					"type": "string"
				},
				"allow": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"Config": {
			"type": "object",
			"required": [
				"blocks",
				"collections",
				"settings"
			],
			"properties": {
				"$schema": {
					"type": "string"
				},
				"page": {
					"type": "object",
					"required": [
						"fields"
					],
					"properties": {
						"fields": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/Field"
							}
						}
					}
				},
				"blocks": {
					"type": "object",
					"patternProperties": {
						"^.*$": {
							"type": "object",
							"required": [
								"label",
								"fields"
							],
							"properties": {
								"label": {
									"type": "string"
								},
								"icon": {
									"type": "string"
								},
								"category": {
									"type": "string"
								},
								"description": {
									"type": "string"
								},
								"fields": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/Field"
									}
								}
							}
						}
					}
				},
				"collections": {
					"type": "object",
					"patternProperties": {
						"^.*$": {
							"type": "object",
							"required": [
								"label",
								"fields"
							],
							"properties": {
								"label": {
									"type": "string"
								},
								"singular": {
									"type": "string"
								},
								"icon": {
									"type": "string"
								},
								"route": {
									"type": "string",
									"pattern": "^/[a-z0-9/_-]*[a-z0-9_-]$"
								},
								"dateField": {
									"type": "string"
								},
								"sort": {
									"type": "object",
									"required": [
										"field"
									],
									"properties": {
										"field": {
											"type": "string"
										},
										"order": {
											"anyOf": [
												{
													"type": "string",
													"const": "asc"
												},
												{
													"type": "string",
													"const": "desc"
												}
											]
										}
									}
								},
								"columns": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"fields": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/Field"
									}
								}
							}
						}
					}
				},
				"settings": {
					"type": "object",
					"patternProperties": {
						"^.*$": {
							"type": "object",
							"required": [
								"label",
								"fields"
							],
							"properties": {
								"label": {
									"type": "string"
								},
								"icon": {
									"type": "string"
								},
								"fields": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/Field"
									}
								}
							}
						}
					}
				}
			},
			"additionalProperties": false
		}
	},
	"$ref": "#/$defs/Config"
}