{
	"name": "mens-clicle-cms",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Block-based CMS powered by Bun + Elysia 2",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "NODE_ENV=production bun src/index.ts",
		"build": "bun build --compile --minify src/index.ts --outfile dist/cms",
		"schema": "bun scripts/schema.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@elysia/html": "2.0.0-rc.0",
		"@preact/signals": "^2.11.3",
		"elysia": "2.0.0-rc.0",
		"exact-mirror": "^1.2.6",
		"openapi-types": "^12.1.3",
		"preact": "^11.0.2",
		"typebox": "^1.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
